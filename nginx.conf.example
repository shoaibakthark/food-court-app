# Sample Nginx Configuration for AWS Lightsail / EC2 Host
# Place this at /etc/nginx/sites-available/foodcourt
# Then enable it: sudo ln -s /etc/nginx/sites-available/foodcourt /etc/nginx/sites-enabled/

server {
    listen 80;
    server_name foodcourt.work.gd;


    client_max_body_size 50M;

    # Forward all traffic to the Next.js standalone container
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
